# Copia este archivo como .env.local y llena los valores. NUNCA subas .env.local a GitHub
# (ya está en .gitignore). Los pasos para conseguir cada valor están en CONFIGURAR.md.

# Supabase → Project Settings → Data API → «API URL»
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Supabase → Project Settings → API Keys → «Publishable key» (sb_publishable_…)
# ¡NO pongas aquí la Secret key (sb_secret_…)!
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Groq → console.groq.com → API Keys (solo se usa en el servidor)
GROQ_API_KEY=gsk_...
# Modelo de Groq (revisa los disponibles en console.groq.com/docs/models)
GROQ_MODEL=openai/gpt-oss-120b

# (Opcional) Código de Google Search Console para comprobar que la web es tuya
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
